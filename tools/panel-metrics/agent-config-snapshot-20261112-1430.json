    {
      "id": "lock",
      "label": "Lock",
      "icon": "🔒",
      "color": "#ef4444",
      "cmd": "builtin:lock",
      "toggle": false
    }
  ],
  "rules": [],
  "charge": {
    "enabled": false,
    "min": 50,
    "max": 80,
    "method": "ha"
  },
  "phones": [],
