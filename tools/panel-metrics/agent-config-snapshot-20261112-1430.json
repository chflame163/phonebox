{
  "codexBar": {
    "providers": [
      "claude",
      "codex",
      "antigravity"
    ],
    "rotate": true,
    "pageSize": 2,
    "rotateInterval": 8
  },
  "controls": {
    "allowListening": false,
    "allowPower": false,
    "actions": [],
    "profiles": []
  },
  "weather": {
    "city": "Beijing",
    "lat": 39.89,
    "lon": 116.84
  },
  "night": {
    "enabled": true,
    "start": "00:30",
    "end": "07:30",
    "brightness": 0.02
  },
  "display": {
    "showSeconds": true,
    "idleReturnSec": 90,
    "vibrate": true,
    "volumeKeys": true,
    "orientation": "landscape",
    "theme": "default",
    "accent": "#2dd4bf",
    "artTint": true,
    "autoBrightness": false,
    "nightWhenDark": false,
    "proximityWake": true,
    "pin": false,
    "homeScreen": true,
    "keepAwake": true,
    "powerStandby": true,
    "powerStandbyDelaySec": 5,
    "followComputerLock": false,
    "switchCountdownSec": 3,
    "touchGraceSec": 20,
    "minDwellSec": 15,
    "holdMaxMin": 30
  },
  "lan": {
    "enabled": true,
    "port": 8766,
    "token": "<REDACTED lan.token, fill from deployed config>",
    "webhookToken": "<REDACTED lan.webhookToken>"
  },
  "updates": {
    "auto": false,
    "repo": "ersinkoc/phonebox"
  },
  "claude": {
    "phoneApprovals": true,
    "timeoutSec": 90,
    "onlyWhenAway": false
  },
  "pages": [
    {
      "id": "home",
      "title": "Home",
      "icon": "🏠",
      "enabled": true,
      "widgets": [
        {
          "id": "push",
          "type": "push",
          "x": 6,
          "y": 2,
          "w": 2,
          "h": 2,
          "options": {
            "key": "strata_tps",
            "title": "Decode",
            "unit": "tok/s",
            "style": "big"
          }
        },
        {
          "id": "push-2",
          "type": "push",
          "x": 8,
          "y": 2,
          "w": 2,
          "h": 2,
          "options": {
            "key": "strata_prefill",
            "title": "Prefill",
            "unit": "t/s",
            "style": "big"
          }
        },
        {
          "id": "push-3",
          "type": "push",
          "x": 10,
          "y": 2,
          "w": 2,
          "h": 2,
          "options": {
            "key": "strata_ctx",
            "title": "Context",
            "unit": "%",
            "style": "gauge",
            "min": 0,
            "max": 100
          }
        },
        {
          "id": "push-5",
          "type": "push",
          "x": 3,
          "y": 0,
          "w": 3,
          "h": 4,
          "options": {
            "key": "gpu_power",
            "title": "GPU Power",
            "unit": "W",
            "style": "gauge",
            "max": 350
          }
        },
        {
          "id": "stat",
          "type": "stat",
          "x": 0,
          "y": 4,
          "w": 3,
          "h": 2,
          "options": {
            "metric": "cpu"
          }
        },
        {
          "id": "stat-2",
          "type": "stat",
          "x": 3,
          "y": 4,
          "w": 3,
          "h": 2,
          "options": {
            "metric": "gpu"
          }
        },
        {
          "id": "stat-3",
          "type": "stat",
          "x": 6,
          "y": 4,
          "w": 3,
          "h": 2,
          "options": {
            "metric": "ram"
          }
        },
        {
          "id": "stat-4",
          "type": "stat",
          "x": 9,
          "y": 4,
          "w": 3,
          "h": 2,
          "options": {
            "metric": "net"
          }
        },
        {
          "id": "topprocs",
          "type": "topprocs",
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 4,
          "options": {
            "sort": "cpu"
          }
        },
        {
          "id": "meters",
          "type": "meters",
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 2,
          "options": {}
        }
      ]
    },
    {
      "id": "system",
      "title": "System Monitor",
      "icon": "📊",
      "enabled": true,
      "widgets": [
        {
          "id": "chart",
          "type": "chart",
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 3,
          "options": {
            "metrics": [
              "cpu"
            ]
          }
        },
        {
          "id": "chart-2",
          "type": "chart",
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 3,
          "options": {
            "metrics": [
              "gpu"
            ]
          }
        },
        {
          "id": "meters",
          "type": "meters",
          "x": 0,
          "y": 3,
          "w": 6,
          "h": 3
        },
        {
          "id": "chart-3",
          "type": "chart",
          "x": 6,
          "y": 3,
          "w": 6,
          "h": 3,
          "options": {
            "metrics": [
              "down",
              "up"
            ]
          }
        }
      ]
    },
    {
      "id": "procs",
      "title": "Calendar and Weather",
      "icon": "🏠",
      "enabled": true,
      "widgets": [
        {
          "id": "forecast",
          "type": "forecast",
          "x": 9,
          "y": 0,
          "w": 3,
          "h": 6,
          "options": {
            "mode": "hourly"
          }
        },
        {
          "id": "clock",
          "type": "clock",
          "x": 4,
          "y": 0,
          "w": 5,
          "h": 4,
          "options": {
            "status": true,
            "weather": true,
            "date": true
          }
        },
        {
          "id": "calendar",
          "type": "calendar",
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 6,
          "options": {}
        },
        {
          "id": "air",
          "type": "air",
          "x": 4,
          "y": 4,
          "w": 5,
          "h": 2,
          "options": {}
        }
      ]
    }
  ],
  "shortcuts": [
    {
      "id": "terminal",
      "label": "Terminal",
      "icon": "⌨️",
      "color": "#4b5563",
      "cmd": "x-terminal-emulator",
      "toggle": false
    },
    {
      "id": "files",
      "label": "Files",
      "icon": "📁",
      "color": "#e5b84b",
      "cmd": "xdg-open",
      "args": "~",
      "toggle": false
    },
    {
      "id": "vscode",
      "label": "VS Code",
      "icon": "📝",
      "color": "#2f80ed",
      "cmd": "code",
      "toggle": false
    },
    {
      "id": "browser",
